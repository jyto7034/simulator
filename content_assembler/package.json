{
  "name": "content-assembler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit && tsc --project tsconfig.ui.json --noEmit",
    "build": "npm run licenses && npm run typecheck && vite build",
    "licenses": "node scripts/third-party-notices.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run contract:check",
    "contract:check": "node --experimental-transform-types scripts/export-node-contract.mjs --check",
    "contract:export": "node --experimental-transform-types scripts/export-node-contract.mjs",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "preview": "vite preview",
    "ui:install": "playwright install chromium --only-shell",
    "ui:list": "playwright test --list",
    "ui:inspect": "playwright test --grep-invert @visual",
    "ui:compare": "playwright test --grep @visual",
    "ui:baseline": "playwright test --grep @visual --update-snapshots=all",
    "ui:report": "playwright show-report artifacts/ui/report",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test": "playwright test --config=playwright.model.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "elkjs": "0.12.0",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
