(relics: [(
    id: "causal_example", uuid: "ed908b17-a36c-4ff5-98d8-654ef49f2476",
    name: "Causal authoring example", description: "Finite native consumers",
    rarity: "example", allow_duplicates: false, effects: [], dismantle_equipment_dust: 1,
    rules: [
        (id: "wedge", selector: (effect: (all_tags: ["multi_hit"])),
         apply: Wedge(increment_percent: 10)),
        (id: "echo", apply: Subscribe((
            event: DamageHpLost(perspective: Dealt), source: (all_tags: ["direct"]),
            payload: Program((steps: [
                (id: "echo", delay_ms: 10, target: EventTarget, delivery: Instant,
                 effects: [(id: "echo_damage", tags: ["causal_child"], op: Damage(amount: 5, damage_type: True))]),
            ])),
        ))),
        (id: "joined", apply: Subscribe((
            event: DamageHpLost(perspective: Dealt), source: (all_tags: ["direct"]),
            payload: Join(branches: [
                (id: "then", program: (steps: [(id: "hit", target: EventTarget,
                    effects: [(id: "damage", op: Damage(amount: 2, damage_type: True))])])),
                (id: "delayed", program: (steps: [(id: "hit", delay_ms: 20, target: EventTarget,
                    effects: [(id: "damage", op: Damage(amount: 3, damage_type: True))])])),
            ], then: (steps: [(id: "hit", target: EventTarget,
                effects: [(id: "damage", op: Damage(amount: 7, damage_type: True))])])),
        ))),
        (id: "pulse", apply: Periodic(interval_ms: 3000, payload: Program((steps: [
            (id: "pulse", target: Owner, effects: [(id: "heal", op: Heal(amount: 1))]),
        ])))),
    ],
)])
