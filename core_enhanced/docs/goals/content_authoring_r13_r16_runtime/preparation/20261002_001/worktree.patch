+fn checked_percent_product_ceil(left_percent: u32, right_percent: u32) -> Option<u32> {
+    let product = u64::from(left_percent).checked_mul(u64::from(right_percent))?;
+    let rounded = product.checked_add(99)?.checked_div(100)?;
