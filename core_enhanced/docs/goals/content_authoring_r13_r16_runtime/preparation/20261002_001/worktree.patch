+            self.breakdown = BreakdownCounter::Inactive;
+        } else if matches!(self.breakdown, BreakdownCounter::Inactive) {
+            self.breakdown = BreakdownCounter::Active {
+                remaining_nodes: limit,
+                entered_node: node,
