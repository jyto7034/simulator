+            start_time_ms,
+            end_time_ms,
+            start_position: sample_projectile_position_at(
+                trajectory_start,
+                trajectory_aim,
+                from_elapsed_ms,
+                total_ms,
+            ),
+            end_position: sample_projectile_position_at(
+                trajectory_start,
+                trajectory_aim,
+                to_elapsed_ms,
+                total_ms,
+            ),
+        }
+    }
