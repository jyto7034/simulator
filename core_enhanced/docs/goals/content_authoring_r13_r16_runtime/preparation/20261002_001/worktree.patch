+            vn_id: VisualNovelId::new("hq_briefing_endless_intro"),
+            current_scene_id: VisualNovelSceneId::new("start"),
+            committed_choice_id: None,
+            blocking: true,
+            presentation_mode:
+                crate::game::visual_novel::VisualNovelSessionPresentationMode::Cinematic,
+        }
+    );
+    assert_eq!(
