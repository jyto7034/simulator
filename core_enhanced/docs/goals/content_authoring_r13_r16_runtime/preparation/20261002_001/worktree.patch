+        .unwrap();
+    core.execute(player_id, PlayerBehavior::ConfirmEnterNode)
+        .unwrap();
+    let before = battle_advance_atomic_snapshot(&core);
+    let mut operation_ran = false;
+
+    let error = core
+        .with_state_transaction(|_| -> Result<(), GameError> {
+            operation_ran = true;
+            Ok(())
