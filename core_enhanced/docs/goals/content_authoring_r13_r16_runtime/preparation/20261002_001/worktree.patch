+
+fn write_canonical_json(value: &Value, output: &mut Vec<u8>) -> Result<(), serde_json::Error> {
+    match value {
+        Value::Null | Value::Bool(_) | Value::Number(_) | Value::String(_) => {
+            serde_json::to_writer(output, value)?;
+        }
+        Value::Array(values) => {
+            output.push(b'[');
+            for (index, value) in values.iter().enumerate() {
+                if index > 0 {
+                    output.push(b',');
+                }
+                write_canonical_json(value, output)?;
+            }
+            output.push(b']');
+        }
+        Value::Object(values) => {
+            output.push(b'{');
+            let mut keys = values.keys().collect::<Vec<_>>();
+            keys.sort_unstable();
+            for (index, key) in keys.into_iter().enumerate() {
+                if index > 0 {
+                    output.push(b',');
+                }
+                serde_json::to_writer(&mut *output, key)?;
+                output.push(b':');
+                write_canonical_json(&values[key], output)?;
+            }
+            output.push(b'}');
+        }
+    }
+    Ok(())
+}
+
+pub(super) fn active_run_checkpoint_sha256(
+    checkpoint: &RunCheckpointPayload,
+) -> Result<String, GameError> {
+    let value = serde_json::to_value(checkpoint)
+        .map_err(|error| active_run_checkpoint_codec_error("serialization", error))?;
+    let mut canonical_json = Vec::new();
+    write_canonical_json(&value, &mut canonical_json)
+        .map_err(|error| active_run_checkpoint_codec_error("serialization", error))?;
+    let digest = Sha256::digest(canonical_json);
+    let mut encoded = String::with_capacity(64);
+    for byte in digest {
+        use std::fmt::Write;
+        write!(&mut encoded, "{byte:02x}").expect("writing to a String is infallible");
+    }
+    Ok(encoded)
+}
+
+pub(super) fn encode_active_run_checkpoint(
+    checkpoint: &RunCheckpointPayload,
+) -> Result<Vec<u8>, GameError> {
+    let checkpoint_sha256 = active_run_checkpoint_sha256(checkpoint)?;
+    let value = serde_json::to_value(&ActiveRunCorePayloadV9Ref {
+        version: ACTIVE_RUN_CORE_PAYLOAD_VERSION,
+        checkpoint,
+        checkpoint_sha256,
+    })
+    .map_err(|error| active_run_checkpoint_codec_error("serialization", error))?;
+    let mut bytes = Vec::new();
+    write_canonical_json(&value, &mut bytes)
+        .map_err(|error| active_run_checkpoint_codec_error("serialization", error))?;
+    Ok(bytes)
+}
+
+fn parse_active_run_checkpoint<T>(core_payload_json: &[u8]) -> Result<T, GameError>
+where
+    T: for<'de> Deserialize<'de>,
+{
+    serde_json::from_slice(core_payload_json)
+        .map_err(|error| active_run_checkpoint_codec_error("deserialization", error))
+}
+
+fn import_v9_checkpoint(core_payload_json: &[u8]) -> Result<RunCheckpointPayload, GameError> {
+    let document: ActiveRunCorePayloadV9 = parse_active_run_checkpoint(core_payload_json)?;
+    if document.version != ACTIVE_RUN_CORE_PAYLOAD_VERSION {
+        return Err(GameError::InvalidStaticData(format!(
+            "unsupported active-run core payload version {}",
+            document.version
+        )));
+    }
+    let expected = active_run_checkpoint_sha256(&document.checkpoint)?;
+    if document.checkpoint_sha256.len() != 64
+        || !document
+            .checkpoint_sha256
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+        || document.checkpoint_sha256 != expected
+    {
+        return Err(GameError::InvalidStaticData(
+            "active-run checkpoint SHA-256 mismatch".to_string(),
+        ));
+    }
+    // The parser above constructed a fresh insert-only HashMap. Register its
+    // reservation before the first continuation clone, preserving older family
+    // credit. Native capture/restore copies must never reseed from capacity.
+    crate::authoring::control::monolith_imported_fresh(
+        document
+            .checkpoint
+            .encounter_progression
+            .monolith
+            .remanifestation_nodes
+            .capacity(),
+    );
+    Ok(document.checkpoint)
+}
+
+fn import_active_run_checkpoint(
+    core_payload_json: &[u8],
+) -> Result<RunCheckpointPayload, GameError> {
+    let header: ActiveRunCorePayloadHeader = parse_active_run_checkpoint(core_payload_json)?;
+    match header.version {
+        ACTIVE_RUN_CORE_PAYLOAD_VERSION => import_v9_checkpoint(core_payload_json),
+        version => Err(GameError::InvalidStaticData(format!(
+            "unsupported active-run core payload version {version}"
+        ))),
+    }
+}
 
