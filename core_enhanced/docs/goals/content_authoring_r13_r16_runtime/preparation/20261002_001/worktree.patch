+impl PartialEq for DamageSourceSnapshot {
+    fn eq(&self, other: &Self) -> bool {
+        let cast_equal = match (&self.skill_cast_source, &other.skill_cast_source) {
+            (None, None) => true,
+            (Some(left), Some(right)) => {
+                left.skill_id == right.skill_id
