+            results.push((
+                usage,
+                serde_json::to_value(core.authoring_observation().unwrap()).unwrap(),
+                serde_json::to_value(&core.event_log).unwrap(),
+                core.units[&target].resonance_current,
+            ));
+        }
+        assert_eq!(results[0], results[1]);
+        assert_eq!(results[0], results[2]);
+    }
