+        for raw in ["(x:NaN,y:0.0)", "(x:inf,y:0.0)", "(x:0.0,y:-inf)"] {
+            assert!(ron::de::from_str::<WorldVec2>(raw).is_err(), "{raw}");
+        }
+
+        for (x, y, component) in [
+            (f32::NAN, 0.0, "position.x"),
