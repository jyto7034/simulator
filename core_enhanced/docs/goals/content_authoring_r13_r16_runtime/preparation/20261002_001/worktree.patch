+fn live_little_red_no_target_and_locked_target_failure_paths_rejoin_authored_route() {
+    let (mut no_target, _, _, _) =
+        enter_live_little_red_reference(live_game_data_from_ron(), 0xB055_0502, false);
+    for unit in no_target
