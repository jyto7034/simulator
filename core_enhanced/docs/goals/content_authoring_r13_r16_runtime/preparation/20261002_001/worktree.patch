+        ProjectileMotionResult {
+            end_position: self.end_position,
+            next_reevaluation_ms: self
+                .end_time_ms
+                .saturating_add(PROJECTILE_REEVALUATION_TICK_MS),
+            ordered_impacts: impacts.into_iter().map(|(impact, _)| impact).collect(),
+        }
+    }
+}
