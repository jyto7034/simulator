          "text": "    let controlled = attempt(&fixture, &limits).unwrap();"
        },
        {
          "line": 29,
          "text": "    assert_eq!(controlled.token().identity(), plain.identity());"
        },
        {
          "line": 30,
          "text": "    assert_eq!(controlled.token().source_receipt(), plain.source_receipt());"
        },
