          "text": "    );"
        },
        {
          "line": 36,
          "text": "    assert!(usage.work > 0);"
        },
        {
          "line": 37,
          "text": "    assert!(usage.pending_events_peak > 0);"
        },
        {
          "line": 38,
          "text": "    assert!(usage.retained_entities_peak > 0);"
        },
        {
