          },
          {
            "Policy Element Revision Ref": {
              "Artifact Type": "Policy Element Revision",
              "Artifact ID": "PER-CMVA-07-REVIEWED-001",
              "Content Digest": "sha256:998947ab3607875c40386ec0c12565403793fb0c11bad8553cfa2a64ccee9cd4"
            },
            "Observable Policy Acceptance": [
