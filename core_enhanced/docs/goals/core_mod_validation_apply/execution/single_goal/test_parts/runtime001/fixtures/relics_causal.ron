(relics:[(
 id:"u11_causal_relic",uuid:"c0de1100-0000-0000-0000-000000000202",
 name:"Independent causal graph",description:"Finite distinct source, branches and continuation",
 rarity:"probe",allow_duplicates:false,effects:[],dismantle_equipment_dust:1,
 rules:[
  (id:"wedge",selector:(effect:(all_tags:["u11_multi_hit"])),apply:Wedge(increment_percent:10)),
  (id:"echo",apply:Subscribe((event:DamageHpLost(perspective:Dealt),source:(all_tags:["u11_direct"]),
   payload:Program((steps:[(id:"echo",target:EventTarget,effects:[(id:"echo",op:Damage(amount:7,damage_type:True))])]))))),
  (id:"joined",apply:Subscribe((event:DamageHpLost(perspective:Dealt),source:(all_tags:["u11_direct"]),
   payload:Join(branches:[
    (id:"left",program:(steps:[(id:"left",target:EventTarget,effects:[(id:"left",op:Damage(amount:2,damage_type:True))])])),
    (id:"right",program:(steps:[(id:"right",delay_ms:5,target:EventTarget,effects:[(id:"right",op:Damage(amount:3,damage_type:True))])])),
   ],then:(steps:[(id:"joined",target:EventTarget,effects:[(id:"joined",op:Damage(amount:5,damage_type:True))])]))))),
  (id:"pulse",apply:Periodic(interval_ms:1000,payload:Program((steps:[
   (id:"pulse",target:Owner,effects:[(id:"pulse",op:HealthCost(amount:3,allow_lethal:false))])]
  )))),
 ]
)])
