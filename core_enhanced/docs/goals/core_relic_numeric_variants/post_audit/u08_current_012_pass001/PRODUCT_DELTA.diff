+        let m = event.scenes.len();
+        let work = n
+            .checked_mul(n)
+            .and_then(|a| m.checked_mul(m).and_then(|b| a.checked_add(b)))
+            .and_then(|a| n.checked_mul(m).and_then(|b| a.checked_add(b)))
