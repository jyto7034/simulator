+            },
+        ),
+        &source(),
+        DeliveryCapabilities::all(),
+        &ExprLimits::default(),
+    )
+    .unwrap_err();
+    assert_eq!(divide_zero.code, ValueExprFaultCode::DivideByZero);
+
+    let invalid_clamp = compile(
+        &AmountExpr::authored(
+            EvalMoment::Live,
+            ValueExpr::Clamp {
+                value: Box::new(typed(3, ValueUnit::Magnitude)),
