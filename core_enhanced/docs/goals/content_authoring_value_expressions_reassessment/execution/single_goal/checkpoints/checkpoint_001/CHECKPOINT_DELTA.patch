+use std::collections::BTreeMap;
+
+use crate::game::ability::authoring::EffectSite;
+
+use super::compile::divide_rounded;
+use super::{
+    CompiledAmountPlan, CompiledOp, EvalFrame, EvalMember, EvaluatedAmount, ExprMeter,
+    FiniteSource, GroupOwner, GroupOwnerDomain, Grouping, ProjectedTile, Reduction, TraceEntry,
+    TypedInteger, ValueExprFault, ValueExprFaultCode, ValueExprPhase, ValueRef, ValueUnit,
+};
+
+struct SegmentTask {
+    segment: usize,
+    pc: usize,
+    values: Vec<TypedInteger>,
+    member: Option<EvalMember>,
+}
+
+struct AggregateTask {
+    members: Vec<EvalMember>,
+    next_member: usize,
+    awaiting_member: bool,
+    member_segment: usize,
+    grouping: Grouping,
+    reduction: Reduction,
+    outer_reduction: Option<Reduction>,
+    member_unit: ValueUnit,
+    result_unit: ValueUnit,
+    node_index: usize,
+    groups: BTreeMap<GroupKey, Vec<TypedInteger>>,
+}
+
+enum Task {
+    Segment(SegmentTask),
+    Aggregate(AggregateTask),
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]
+enum GroupKey {
+    WholeSet,
+    Owner(GroupOwner),
+    ProjectedTile(ProjectedTile),
+}
+
+pub fn evaluate(
+    plan: &CompiledAmountPlan,
+    frame: &EvalFrame,
+    meter: &mut ExprMeter,
+) -> Result<EvaluatedAmount, ValueExprFault> {
+    if meter.limits.max_depth > plan.limits.max_depth
+        || meter.limits.max_nodes > plan.limits.max_nodes
+        || meter.limits.max_stack > plan.limits.max_stack
+        || meter.limits.max_dynamic_members > plan.limits.max_dynamic_members
+        || meter.limits.max_groups > plan.limits.max_groups
+        || meter.limits.max_work > plan.limits.max_work
+        || meter.limits.max_retained_bytes > plan.limits.max_retained_bytes
+    {
+        return Err(fault(
+            plan,
+            ValueExprFaultCode::BudgetExceeded,
+            0,
+            None,
+            None,
+            "evaluation meter cannot exceed the plan admission limits",
+            ValueExprPhase::Evaluate,
+        ));
+    }
+
+    let mut tasks = vec![Task::Segment(SegmentTask {
+        segment: 0,
+        pc: 0,
+        values: Vec::new(),
+        member: None,
+    })];
+    let mut returned: Option<TypedInteger> = None;
+    let mut trace = Vec::new();
+
+    loop {
+        let Some(task) = tasks.last_mut() else {
+            let value = returned.ok_or_else(|| {
+                fault(
+                    plan,
+                    ValueExprFaultCode::Unavailable,
+                    0,
+                    None,
+                    None,
+                    "evaluator ended without a root value",
+                    ValueExprPhase::Evaluate,
+                )
+            })?;
+            if value.unit != *plan.result_unit() {
+                return Err(fault(
+                    plan,
+                    ValueExprFaultCode::UnitMismatch,
+                    0,
+                    Some(plan.result_unit().clone()),
+                    Some(value.unit),
+                    "evaluated root unit differs from the compiled result unit",
+                    ValueExprPhase::Evaluate,
+                ));
+            }
+            return Ok(EvaluatedAmount { value, trace });
+        };
+
+        match task {
+            Task::Segment(segment) => {
+                if let Some(value) = returned.take() {
+                    segment.values.push(value);
+                }
+                let ops = plan.segment(segment.segment).ok_or_else(|| {
+                    fault(
+                        plan,
+                        ValueExprFaultCode::Unavailable,
+                        0,
+                        None,
+                        None,
+                        "compiled segment is missing",
+                        ValueExprPhase::Evaluate,
+                    )
+                })?;
+                if segment.pc == ops.len() {
+                    if segment.values.len() != 1 {
+                        return Err(fault(
+                            plan,
+                            ValueExprFaultCode::Unavailable,
+                            0,
+                            None,
+                            None,
+                            "compiled segment did not yield exactly one value",
+                            ValueExprPhase::Evaluate,
+                        ));
+                    }
+                    returned = segment.values.pop();
+                    tasks.pop();
+                    continue;
+                }
+
+                let op = &ops[segment.pc];
+                charge_work(plan, meter, op.node_index(), 1)?;
+                match op {
+                    CompiledOp::Aggregate {
+                        source,
+                        grouping,
+                        reduction,
+                        outer_reduction,
+                        member_segment,
+                        member_unit,
+                        result_unit,
+                        node_index,
+                    } => {
+                        let members = members(plan, frame, meter, source, *grouping, *node_index)?;
+                        segment.pc += 1;
+                        tasks.push(Task::Aggregate(AggregateTask {
+                            members,
+                            next_member: 0,
+                            awaiting_member: false,
+                            member_segment: *member_segment,
+                            grouping: *grouping,
+                            reduction: *reduction,
+                            outer_reduction: *outer_reduction,
+                            member_unit: member_unit.clone(),
+                            result_unit: result_unit.clone(),
+                            node_index: *node_index,
+                            groups: BTreeMap::new(),
+                        }));
+                    }
+                    _ => {
+                        let value = execute_op(plan, frame, meter, op, segment, &mut trace)?;
+                        segment.values.push(value);
+                        segment.pc += 1;
+                    }
+                }
+            }
+            Task::Aggregate(aggregate) => {
+                if aggregate.awaiting_member {
+                    let value = returned.take().ok_or_else(|| {
+                        fault(
+                            plan,
+                            ValueExprFaultCode::Unavailable,
+                            aggregate.node_index,
+                            Some(aggregate.member_unit.clone()),
+                            None,
+                            "aggregate member segment did not return a value",
+                            ValueExprPhase::Evaluate,
+                        )
+                    })?;
+                    if value.unit != aggregate.member_unit {
+                        return Err(fault(
+                            plan,
+                            ValueExprFaultCode::UnitMismatch,
+                            aggregate.node_index,
+                            Some(aggregate.member_unit.clone()),
+                            Some(value.unit),
+                            "aggregate member result unit changed after compilation",
+                            ValueExprPhase::Evaluate,
+                        ));
+                    }
+                    let member = &aggregate.members[aggregate.next_member];
+                    let key = group_key(plan, aggregate.grouping, member, aggregate.node_index)?;
+                    if !aggregate.groups.contains_key(&key) {
+                        charge_group(plan, meter, aggregate.node_index)?;
+                    }
+                    charge_retained(
+                        plan,
+                        meter,
+                        aggregate.node_index,
+                        std::mem::size_of::<TypedInteger>() + member.identity.len(),
+                    )?;
+                    aggregate.groups.entry(key).or_default().push(value);
+                    aggregate.next_member += 1;
+                    aggregate.awaiting_member = false;
+                }
+
+                if aggregate.next_member < aggregate.members.len() {
+                    let member = aggregate.members[aggregate.next_member].clone();
+                    let member_segment = aggregate.member_segment;
+                    aggregate.awaiting_member = true;
+                    tasks.push(Task::Segment(SegmentTask {
+                        segment: member_segment,
+                        pc: 0,
+                        values: Vec::new(),
+                        member: Some(member),
+                    }));
+                    continue;
+                }
+
+                let value = finish_aggregate(plan, aggregate)?;
+                push_trace(plan, meter, &mut trace, aggregate.node_index, None, &value)?;
+                returned = Some(value);
+                tasks.pop();
+            }
+        }
+    }
+}
+
+fn execute_op(
+    plan: &CompiledAmountPlan,
+    frame: &EvalFrame,
+    meter: &mut ExprMeter,
+    op: &CompiledOp,
+    segment: &mut SegmentTask,
+    trace: &mut Vec<TraceEntry>,
+) -> Result<TypedInteger, ValueExprFault> {
+    let (node_index, value) = match op {
+        CompiledOp::PushConst { value, node_index } => (*node_index, value.clone()),
+        CompiledOp::Read {
+            reference,
+            node_index,
+        } => (
+            *node_index,
+            read_value(plan, frame, segment.member.as_ref(), reference, *node_index)?,
+        ),
+        CompiledOp::Add {
+            arity,
+            unit,
+            node_index,
+        } => {
+            let values = take_values(plan, &mut segment.values, *arity, *node_index)?;
+            let mut result = 0_i128;
+            for value in values {
+                require_unit(plan, *node_index, unit, &value)?;
+                result = result.checked_add(value.value).ok_or_else(|| {
+                    fault(
+                        plan,
+                        ValueExprFaultCode::Overflow,
+                        *node_index,
+                        Some(unit.clone()),
+                        Some(unit.clone()),
+                        "Add overflowed i128",
+                        ValueExprPhase::Evaluate,
+                    )
+                })?;
+            }
+            (*node_index, TypedInteger::new(result, unit.clone()))
+        }
+        CompiledOp::Mul { unit, node_index } => {
+            let values = take_values(plan, &mut segment.values, 2, *node_index)?;
+            let result = values[0]
+                .value
+                .checked_mul(values[1].value)
+                .ok_or_else(|| {
+                    fault(
+                        plan,
+                        ValueExprFaultCode::Overflow,
+                        *node_index,
+                        Some(unit.clone()),
+                        Some(unit.clone()),
+                        "Mul overflowed i128",
+                        ValueExprPhase::Evaluate,
+                    )
+                })?;
+            (*node_index, TypedInteger::new(result, unit.clone()))
+        }
+        CompiledOp::Ratio {
+            rounding,
+            unit,
+            node_index,
+        } => {
+            let values = take_values(plan, &mut segment.values, 2, *node_index)?;
+            if values[1].value == 0 {
+                return Err(fault(
+                    plan,
+                    ValueExprFaultCode::DivideByZero,
+                    *node_index,
+                    Some(values[1].unit.clone()),
+                    Some(values[1].unit.clone()),
+                    "Ratio denominator is zero",
+                    ValueExprPhase::Evaluate,
+                ));
+            }
+            let result =
+                divide_rounded(values[0].value, values[1].value, *rounding).ok_or_else(|| {
+                    fault(
+                        plan,
+                        ValueExprFaultCode::Overflow,
+                        *node_index,
+                        Some(unit.clone()),
+                        Some(unit.clone()),
+                        "Ratio overflowed i128",
+                        ValueExprPhase::Evaluate,
+                    )
+                })?;
+            (*node_index, TypedInteger::new(result, unit.clone()))
+        }
+        CompiledOp::Clamp { unit, node_index } => {
+            let values = take_values(plan, &mut segment.values, 3, *node_index)?;
+            for value in &values {
+                require_unit(plan, *node_index, unit, value)?;
+            }
+            if values[1].value > values[2].value {
+                return Err(fault(
+                    plan,
+                    ValueExprFaultCode::InvalidClamp,
+                    *node_index,
+                    Some(unit.clone()),
+                    Some(unit.clone()),
+                    "Clamp min is greater than max",
+                    ValueExprPhase::Evaluate,
+                ));
+            }
+            (
+                *node_index,
+                TypedInteger::new(
+                    values[0].value.clamp(values[1].value, values[2].value),
+                    unit.clone(),
+                ),
+            )
+        }
+        CompiledOp::Aggregate { .. } => unreachable!("aggregate is handled by the task machine"),
+    };
+    let member_identity = segment
+        .member
+        .as_ref()
+        .map(|member| member.identity.clone());
+    push_trace(plan, meter, trace, node_index, member_identity, &value)?;
+    Ok(value)
+}
+
+fn read_value(
+    plan: &CompiledAmountPlan,
+    frame: &EvalFrame,
+    member: Option<&EvalMember>,
+    reference: &ValueRef,
+    node_index: usize,
+) -> Result<TypedInteger, ValueExprFault> {
+    let value = if let ValueRef::AggregateMember { .. } = reference {
+        member.map(|member| &member.value)
+    } else if reference.is_member_scoped() {
+        member.and_then(|member| member.values.get(reference))
+    } else {
+        frame.values().get(reference)
+    }
+    .ok_or_else(|| {
+        fault(
+            plan,
+            ValueExprFaultCode::MissingContext,
+            node_index,
+            Some(reference.unit()),
+            None,
+            "evaluation frame is missing a required value",
+            ValueExprPhase::Evaluate,
+        )
+    })?
+    .clone();
+    require_unit(plan, node_index, &reference.unit(), &value)?;
+    Ok(value)
+}
+
+fn members(
+    plan: &CompiledAmountPlan,
+    frame: &EvalFrame,
+    meter: &mut ExprMeter,
+    source: &FiniteSource,
+    grouping: Grouping,
+    node_index: usize,
+) -> Result<Vec<EvalMember>, ValueExprFault> {
+    let mut members = match source {
+        FiniteSource::AuthoredMembers(members) => {
+            members.clone().into_iter().map(Into::into).collect()
+        }
+        FiniteSource::ResolvedTargets => frame.resolved_targets().to_vec(),
+    };
+    members.sort_by(|left, right| left.identity.cmp(&right.identity));
+    let mut canonical: Vec<EvalMember> = Vec::with_capacity(members.len());
+    for member in members {
+        if member.identity.trim().is_empty() {
+            return Err(fault(
+                plan,
+                ValueExprFaultCode::InvalidOwner,
+                node_index,
+                None,
+                None,
+                "aggregate member identity must not be empty",
+                ValueExprPhase::Evaluate,
+            ));
+        }
+        if let Some(previous) = canonical.last() {
+            if previous.identity == member.identity {
+                if previous != &member {
+                    return Err(fault(
+                        plan,
+                        ValueExprFaultCode::InvalidOwner,
+                        node_index,
+                        None,
+                        None,
+                        "duplicate member identity has conflicting values",
+                        ValueExprPhase::Evaluate,
+                    ));
+                }
+                continue;
+            }
+        }
+        canonical.push(member);
+    }
+    validate_member_group_keys(plan, grouping, &canonical, node_index)?;
+    charge_members(plan, meter, node_index, canonical.len())?;
+    Ok(canonical)
+}
+
+fn validate_member_group_keys(
+    plan: &CompiledAmountPlan,
+    grouping: Grouping,
+    members: &[EvalMember],
+    node_index: usize,
+) -> Result<(), ValueExprFault> {
+    let mut owner_domain: Option<GroupOwnerDomain> = None;
+    for member in members {
+        match grouping {
+            Grouping::WholeSet => {}
+            Grouping::ByOwner => {
+                let owner = member.owner.as_ref().ok_or_else(|| {
+                    fault(
+                        plan,
+                        ValueExprFaultCode::InvalidOwner,
+                        node_index,
+                        None,
+                        None,
+                        format!("member '{}' has no owner grouping key", member.identity),
+                        ValueExprPhase::Evaluate,
+                    )
+                })?;
+                if owner.identity.trim().is_empty() {
+                    return Err(fault(
+                        plan,
+                        ValueExprFaultCode::InvalidOwner,
+                        node_index,
+                        None,
+                        None,
+                        format!("member '{}' has an empty owner identity", member.identity),
+                        ValueExprPhase::Evaluate,
+                    ));
+                }
+                if owner_domain.is_some_and(|domain| domain != owner.domain) {
+                    return Err(fault(
+                        plan,
+                        ValueExprFaultCode::InvalidOwner,
+                        node_index,
+                        None,
+                        None,
+                        "one aggregate cannot mix owner grouping domains",
+                        ValueExprPhase::Evaluate,
+                    ));
+                }
+                owner_domain = Some(owner.domain);
+            }
+            Grouping::ByProjectedTile if member.projected_tile.is_none() => {
+                return Err(fault(
+                    plan,
+                    ValueExprFaultCode::MissingContext,
+                    node_index,
+                    None,
+                    None,
+                    format!(
+                        "member '{}' has no projected-tile grouping key",
+                        member.identity
+                    ),
+                    ValueExprPhase::Evaluate,
+                ));
+            }
+            Grouping::ByProjectedTile => {}
+        }
+    }
+    Ok(())
+}
+
+fn group_key(
+    plan: &CompiledAmountPlan,
+    grouping: Grouping,
+    member: &EvalMember,
+    node_index: usize,
+) -> Result<GroupKey, ValueExprFault> {
+    match grouping {
+        Grouping::WholeSet => Ok(GroupKey::WholeSet),
+        Grouping::ByOwner => member.owner.clone().map(GroupKey::Owner).ok_or_else(|| {
+            fault(
+                plan,
+                ValueExprFaultCode::InvalidOwner,
+                node_index,
+                None,
+                None,
+                format!("member '{}' has no owner grouping key", member.identity),
+                ValueExprPhase::Evaluate,
+            )
+        }),
+        Grouping::ByProjectedTile => member
+            .projected_tile
+            .map(GroupKey::ProjectedTile)
+            .ok_or_else(|| {
+                fault(
+                    plan,
+                    ValueExprFaultCode::MissingContext,
+                    node_index,
+                    None,
+                    None,
+                    format!(
+                        "member '{}' has no projected-tile grouping key",
+                        member.identity
+                    ),
+                    ValueExprPhase::Evaluate,
+                )
+            }),
+    }
+}
+
+fn finish_aggregate(
+    plan: &CompiledAmountPlan,
+    aggregate: &AggregateTask,
+) -> Result<TypedInteger, ValueExprFault> {
+    let mut group_results = Vec::with_capacity(aggregate.groups.len());
+    if aggregate.groups.is_empty() && aggregate.grouping == Grouping::WholeSet {
+        group_results.push(reduce(
+            plan,
+            aggregate.node_index,
+            aggregate.reduction,
+            &aggregate.member_unit,
+            &[],
+        )?);
+    } else {
+        for values in aggregate.groups.values() {
+            group_results.push(reduce(
+                plan,
+                aggregate.node_index,
+                aggregate.reduction,
+                &aggregate.member_unit,
+                values,
+            )?);
+        }
+    }
+    let value = match aggregate.outer_reduction {
+        Some(outer) => reduce(
+            plan,
+            aggregate.node_index,
+            outer,
+            &reduction_unit(aggregate.reduction, &aggregate.member_unit),
+            &group_results,
+        )?,
+        None => group_results.into_iter().next().ok_or_else(|| {
+            fault(
+                plan,
+                ValueExprFaultCode::Unavailable,
+                aggregate.node_index,
+                Some(aggregate.result_unit.clone()),
+                None,
+                "ungrouped aggregate did not produce a value",
+                ValueExprPhase::Evaluate,
+            )
+        })?,
+    };
+    require_unit(plan, aggregate.node_index, &aggregate.result_unit, &value)?;
+    Ok(value)
+}
+
+fn reduce(
+    plan: &CompiledAmountPlan,
+    node_index: usize,
+    reduction: Reduction,
+    member_unit: &ValueUnit,
+    values: &[TypedInteger],
+) -> Result<TypedInteger, ValueExprFault> {
+    for value in values {
+        require_unit(plan, node_index, member_unit, value)?;
+    }
+    match reduction {
+        Reduction::Count => Ok(TypedInteger::new(values.len() as i128, ValueUnit::Count)),
+        Reduction::Sum => {
+            let mut result = 0_i128;
+            for value in values {
+                result = result.checked_add(value.value).ok_or_else(|| {
+                    fault(
+                        plan,
+                        ValueExprFaultCode::Overflow,
+                        node_index,
+                        Some(member_unit.clone()),
+                        Some(member_unit.clone()),
+                        "aggregate Sum overflowed i128",
+                        ValueExprPhase::Evaluate,
+                    )
+                })?;
+            }
+            Ok(TypedInteger::new(result, member_unit.clone()))
+        }
+        Reduction::Max => values
+            .iter()
+            .max_by_key(|value| value.value)
+            .cloned()
+            .ok_or_else(|| {
+                fault(
+                    plan,
+                    ValueExprFaultCode::Unavailable,
+                    node_index,
+                    Some(member_unit.clone()),
+                    None,
+                    "Max is undefined for an empty finite aggregate",
+                    ValueExprPhase::Evaluate,
+                )
+            }),
+    }
+}
+
+fn reduction_unit(reduction: Reduction, member_unit: &ValueUnit) -> ValueUnit {
+    match reduction {
+        Reduction::Count => ValueUnit::Count,
+        Reduction::Sum | Reduction::Max => member_unit.clone(),
+    }
+}
+
+fn take_values(
+    plan: &CompiledAmountPlan,
+    values: &mut Vec<TypedInteger>,
+    count: usize,
+    node_index: usize,
+) -> Result<Vec<TypedInteger>, ValueExprFault> {
+    let start = values.len().checked_sub(count).ok_or_else(|| {
+        fault(
+            plan,
+            ValueExprFaultCode::Unavailable,
+            node_index,
+            None,
+            None,
+            "evaluation stack underflow",
+            ValueExprPhase::Evaluate,
+        )
+    })?;
+    Ok(values.split_off(start))
+}
+
+fn require_unit(
+    plan: &CompiledAmountPlan,
+    node_index: usize,
+    expected: &ValueUnit,
+    value: &TypedInteger,
+) -> Result<(), ValueExprFault> {
+    if &value.unit == expected {
+        Ok(())
+    } else {
+        Err(fault(
+            plan,
+            ValueExprFaultCode::UnitMismatch,
+            node_index,
+            Some(expected.clone()),
+            Some(value.unit.clone()),
+            "runtime value unit differs from the compiled unit",
+            ValueExprPhase::Evaluate,
+        ))
+    }
+}
+
+fn push_trace(
+    plan: &CompiledAmountPlan,
+    meter: &mut ExprMeter,
+    trace: &mut Vec<TraceEntry>,
+    node_index: usize,
+    member_identity: Option<String>,
+    value: &TypedInteger,
+) -> Result<(), ValueExprFault> {
+    let retained = std::mem::size_of::<TraceEntry>()
+        .checked_add(member_identity.as_ref().map_or(0, String::len))
+        .ok_or_else(|| {
+            fault(
+                plan,
+                ValueExprFaultCode::Overflow,
+                node_index,
+                None,
+                None,
+                "trace retained-size accounting overflowed",
+                ValueExprPhase::Evaluate,
+            )
+        })?;
+    charge_retained(plan, meter, node_index, retained)?;
+    trace.push(TraceEntry {
+        node_index,
+        member_identity,
+        value: value.clone(),
+    });
+    Ok(())
+}
+
+fn charge_work(
+    plan: &CompiledAmountPlan,
+    meter: &mut ExprMeter,
+    node_index: usize,
+    amount: u64,
+) -> Result<(), ValueExprFault> {
+    poll_cancelled(plan, meter, node_index)?;
+    meter.usage.work = meter.usage.work.checked_add(amount).ok_or_else(|| {
+        fault(
+            plan,
+            ValueExprFaultCode::Overflow,
+            node_index,
+            None,
+            None,
+            "evaluation work accounting overflowed",
+            ValueExprPhase::Evaluate,
+        )
+    })?;
+    if meter.usage.work > meter.limits.max_work {
+        return Err(fault(
+            plan,
+            ValueExprFaultCode::BudgetExceeded,
+            node_index,
+            None,
+            None,
+            format!(
+                "evaluation work {} exceeds limit {}",
+                meter.usage.work, meter.limits.max_work
+            ),
+            ValueExprPhase::Evaluate,
+        ));
+    }
+    Ok(())
+}
+
+fn charge_members(
+    plan: &CompiledAmountPlan,
+    meter: &mut ExprMeter,
+    node_index: usize,
+    amount: usize,
+) -> Result<(), ValueExprFault> {
+    meter.usage.dynamic_members =
+        meter
+            .usage
+            .dynamic_members
+            .checked_add(amount)
+            .ok_or_else(|| {
+                fault(
+                    plan,
+                    ValueExprFaultCode::Overflow,
+                    node_index,
+                    None,
+                    None,
+                    "dynamic member accounting overflowed",
+                    ValueExprPhase::Evaluate,
+                )
+            })?;
+    if meter.usage.dynamic_members > meter.limits.max_dynamic_members {
+        return Err(fault(
+            plan,
+            ValueExprFaultCode::BudgetExceeded,
+            node_index,
+            None,
+            None,
+            format!(
+                "dynamic members {} exceed limit {}",
+                meter.usage.dynamic_members, meter.limits.max_dynamic_members
+            ),
+            ValueExprPhase::Evaluate,
+        ));
+    }
+    charge_work(plan, meter, node_index, amount as u64)
+}
+
+fn charge_group(
+    plan: &CompiledAmountPlan,
+    meter: &mut ExprMeter,
+    node_index: usize,
+) -> Result<(), ValueExprFault> {
+    meter.usage.groups = meter.usage.groups.checked_add(1).ok_or_else(|| {
+        fault(
+            plan,
+            ValueExprFaultCode::Overflow,
+            node_index,
+            None,
+            None,
+            "group accounting overflowed",
+            ValueExprPhase::Evaluate,
+        )
+    })?;
+    if meter.usage.groups > meter.limits.max_groups {
+        return Err(fault(
+            plan,
+            ValueExprFaultCode::BudgetExceeded,
+            node_index,
+            None,
+            None,
+            format!(
+                "aggregate groups {} exceed limit {}",
+                meter.usage.groups, meter.limits.max_groups
+            ),
+            ValueExprPhase::Evaluate,
+        ));
+    }
+    Ok(())
+}
+
+fn charge_retained(
+    plan: &CompiledAmountPlan,
+    meter: &mut ExprMeter,
+    node_index: usize,
+    amount: usize,
+) -> Result<(), ValueExprFault> {
+    meter.usage.retained_bytes =
+        meter
+            .usage
+            .retained_bytes
+            .checked_add(amount)
+            .ok_or_else(|| {
+                fault(
+                    plan,
+                    ValueExprFaultCode::Overflow,
+                    node_index,
+                    None,
+                    None,
+                    "retained-byte accounting overflowed",
+                    ValueExprPhase::Evaluate,
+                )
+            })?;
+    if meter.usage.retained_bytes > meter.limits.max_retained_bytes {
+        return Err(fault(
+            plan,
+            ValueExprFaultCode::BudgetExceeded,
+            node_index,
+            None,
+            None,
+            format!(
+                "retained bytes {} exceed limit {}",
+                meter.usage.retained_bytes, meter.limits.max_retained_bytes
+            ),
+            ValueExprPhase::Evaluate,
+        ));
+    }
+    Ok(())
+}
+
+fn poll_cancelled(
+    plan: &CompiledAmountPlan,
+    meter: &ExprMeter,
+    node_index: usize,
+) -> Result<(), ValueExprFault> {
+    if meter.cancelled {
+        Err(fault(
+            plan,
+            ValueExprFaultCode::Cancelled,
+            node_index,
+            None,
+            None,
+            "expression evaluation was cancelled",
+            ValueExprPhase::Evaluate,
+        ))
+    } else {
+        Ok(())
+    }
+}
+
+pub fn narrow_damage(site: &EffectSite, value: &TypedInteger) -> Result<u32, ValueExprFault> {
+    if value.unit != ValueUnit::Magnitude {
+        return Err(narrow_fault(
+            site,
+            ValueExprFaultCode::UnitMismatch,
+            Some(ValueUnit::Magnitude),
+            Some(value.unit.clone()),
+            "Damage amount must have Magnitude unit",
+        ));
+    }
+    u32::try_from(value.value).map_err(|_| {
+        narrow_fault(
+            site,
+            ValueExprFaultCode::Overflow,
+            Some(ValueUnit::Magnitude),
+            Some(ValueUnit::Magnitude),
+            "Damage amount is outside 0..=u32::MAX",
+        )
+    })
+}
+
+pub fn narrow_heal(site: &EffectSite, value: &TypedInteger) -> Result<i32, ValueExprFault> {
+    if value.unit != ValueUnit::Magnitude {
+        return Err(narrow_fault(
+            site,
+            ValueExprFaultCode::UnitMismatch,
+            Some(ValueUnit::Magnitude),
+            Some(value.unit.clone()),
+            "Heal amount must have Magnitude unit",
+        ));
+    }
+    i32::try_from(value.value).map_err(|_| {
+        narrow_fault(
+            site,
+            ValueExprFaultCode::Overflow,
+            Some(ValueUnit::Magnitude),
+            Some(ValueUnit::Magnitude),
+            "Heal amount is outside i32 range",
+        )
+    })
+}
+
+fn narrow_fault(
+    site: &EffectSite,
+    code: ValueExprFaultCode,
+    expected_unit: Option<ValueUnit>,
+    actual_unit: Option<ValueUnit>,
+    cause: impl Into<String>,
+) -> ValueExprFault {
+    ValueExprFault {
+        code,
+        site: site.clone(),
+        node_index: 0,
+        expected_unit,
+        actual_unit,
+        phase: ValueExprPhase::Narrow,
+        cause: cause.into(),
+    }
+}
+
+fn fault(
+    plan: &CompiledAmountPlan,
+    code: ValueExprFaultCode,
+    node_index: usize,
+    expected_unit: Option<ValueUnit>,
+    actual_unit: Option<ValueUnit>,
+    cause: impl Into<String>,
+    phase: ValueExprPhase,
+) -> ValueExprFault {
+    ValueExprFault {
+        code,
+        site: plan.source().site.clone(),
+        node_index,
+        expected_unit,
+        actual_unit,
+        phase,
+        cause: cause.into(),
+    }
+}
