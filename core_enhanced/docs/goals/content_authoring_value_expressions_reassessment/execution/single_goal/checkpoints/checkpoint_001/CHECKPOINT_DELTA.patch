+impl ExprLimits {
+    pub fn validate(self) -> Result<Self, &'static str> {
+        if self.max_depth == 0
+            || self.max_nodes == 0
+            || self.max_stack == 0
+            || self.max_dynamic_members == 0
+            || self.max_groups == 0
+            || self.max_work == 0
+            || self.max_retained_bytes == 0
+        {
+            return Err("all expression limits must be non-zero");
+        }
+        Ok(self)
+    }
