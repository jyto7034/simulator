+                reduction,
+                outer_reduction,
+                member,
+            } => Self::Aggregate {
+                source,
+                grouping,
+                reduction,
+                outer_reduction,
+                member,
+            },
+        }
+    }
+}
+
+impl<'de> Deserialize<'de> for ValueExpr {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
+        D: Deserializer<'de>,
+    {
+        let _guard = enter_node::<D::Error>()?;
+        WireValueExpr::deserialize(deserializer).map(Into::into)
+    }
+}
