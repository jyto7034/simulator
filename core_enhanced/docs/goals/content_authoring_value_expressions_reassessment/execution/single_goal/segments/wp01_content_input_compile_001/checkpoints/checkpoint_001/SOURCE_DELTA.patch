+#[derive(Deserialize)]
+enum WireValueExpr {
+    Const(super::TypedInteger),
+    Read(super::ValueRef),
+    Add(BoundedExprVec),
+    Mul {
+        value: Box<ValueExpr>,
+        scalar: Box<ValueExpr>,
+    },
+    Ratio {
+        numerator: Box<ValueExpr>,
+        denominator: Box<ValueExpr>,
+        rounding: super::Rounding,
