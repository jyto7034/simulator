        208
      ],
      "action": "Copy optional provenance scalar into the existing Attempt before first outer fork; return it only as candidate data; domain+mandatory-output+final-poll success gates aggregate commit."
    }
  ],
  "conditions": [
    {
      "id": "MP012-C01",
      "title": "Closed ingress and explicit known-vs-unknown seed",
      "status": "required_design_condition"
    },
    {
      "id": "MP012-C02",
      "title": "Monotone provenance across inner rollback and restore",
      "status": "required_design_condition"
    },
    {
      "id": "MP012-C03",
      "title": "Domain/result/receipt success plus final poll before aggregate ledger commit",
      "status": "required_design_condition"
    },
    {
      "id": "MP012-C04",
      "title": "Scalar provenance independent of fuel and no TLS borrow across native callbacks",
      "status": "required_design_condition"
    },
    {
      "id": "MP012-C05",
      "title": "A/B and generation ownership carry or reset only with proven whole lineage replacement",
      "status": "required_design_condition"
    },
    {
      "id": "MP012-C06",
      "title": "Trace/readonly isolation; V6 remains semantic bytes with fresh import seed",
      "status": "required_design_condition"
    }
  ],
  "bound": {
    "credit": "Global copied conservative insertion/fresh-reservation credit P",
    "formula": "E(0)=0; otherwise max(16, checked_next_power_of_two(checked(2*P*8)/7))",
    "application": "Charge E(P) independently for every separately owned Monolith map plus owner record and live key/value children",
    "unknown": "Overflow or unproven provenance is never zero cost",
    "not_claimed": [
      "allocator bytes",
      "RSS",
      "arbitrary external raw map coverage",
      "serialized-shape heap proof"
    ]
  },
  "alternatives": [
    {
      "option": "Fresh import boundary hook",
      "assessment": "Smallest identified current seam; keeps public Monolith derived Deserialize unchanged; closed production ingress proof required."
    },
    {
      "option": "Field deserialize_with calling native HashMap::deserialize once",
      "assessment": "Wider typed ingress coverage but wider serde change surface; in-place/diagnostic compatibility not verified here."
    },
    {
      "option": "Fresh seed inclusion by max(P,C) rather than checked-add",
      "assessment": "Valid smaller per-lineage envelope under stated invariant; changes interpretation from total lifetime credit to maximum lineage envelope; root sum candidate remains conservative."
    }
  ],
