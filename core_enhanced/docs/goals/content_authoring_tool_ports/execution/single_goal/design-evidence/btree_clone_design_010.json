{
  "report_id": "R03-BTREE-CLONE-DESIGN-010",
  "type": "bounded_readonly_source_design_not_completion_audit",
  "rust_tag": "1.91.1",
  "constraints": {
    "repo_edits": false,
    "git_commands": false,
    "cargo_build_tests": false,
    "production_review": false,
    "source_downloads": "authorized exact official source into new /tmp files",
    "report_files_no_overwrite": true
  },
  "decision": {
    "recommended_formula": "n==0 => N=0; n>0 => N=1+(n-1)/5; clone logical slots=checked(40*N+1)",
    "status": "source-supported subject to listed valid-state and unit preconditions",
    "outer_unit": "+1 is one collection/root descriptor record, not one scalar machine field",
    "source_empty": "For retained source accounting only, use at most one leaf at n=0; clone destination has zero nodes",
    "child_accounting": "Visit all occupied key/value owned children separately. Typed slot counts do not bound arbitrary child bytes or Clone side effects."
  },
  "proof": {
    "branch_factor_B": 6,
    "kv_capacity_per_node": 11,
    "min_non_root_occupancy": 5,
    "inequality": "n >= 1 + 5*(N-1) for valid nonempty tree",
    "leaf_typed_slots": {
      "parent": 1,
      "parent_idx": 1,
      "len": 1,
      "keys": 11,
      "values": 11,
      "total": 25
    },
    "internal_extra_edge_slots": 12,
    "internal_total_typed_slots": 37,
    "recommended_conservative_node_slots": 40,
    "clone_shape": "one destination node per valid source node, except empty source yields no destination root",
    "overflow": "check subtract/add, 40*N multiplication, +1 and counter conversion; overflow rejects opt-in admission"
  },
  "observations": [
    {
      "id": "BT010-O01",
      "finding": "Normal occupancy allows len-only native node bound without insertion/removal history."
    },
    {
      "id": "BT010-O02",
      "finding": "Empty retained source and empty native clone differ: up to one source leaf; zero clone destination nodes."
    },
    {
      "id": "BT010-O03",
      "finding": "Node capacity has at most37 explicit typed fields;40 per node is conservative, provided root1 is defined as a collection record."
    },
    {
      "id": "BT010-O04",
      "finding": "The bound applies at normal invariant-preserving operation boundaries, not arbitrary transient/panic-recovered/corrupt states."
    },
    {
      "id": "BT010-O05",
      "finding": "BTreeMap default clone_from replaces with Clone; it does not retain native destination node capacity. Coexistence with old destination remains a separate accounting concern."
    }
  ],
  "limitations": [
    "Logical typed storage units only; no installed allocator/RSS/exact byte proof.",
    "No arbitrary K/V/custom allocator Clone coverage; known leaf and child accounting required.",
    "No blanket certification of caught-panic states. bulk_push's final repair follows the main loop.",
    "No exhaustive collection-method panic-safety audit or runtime measurement.",
    "No whole GameCore visitor implementation review and no tests/builds run."
  ],
