  "schema_version": 1,
  "design_id": "R03-TS033",
  "goal_ref": "GS-CATP-P2G50-001/GOAL-CATP-01",
  "scope": "Bounded read-only public opaque TrialSession/simulate/failure/readonly transport design over existing private execution boundary; not a completion audit.",
  "tests_run": false,
  "repo_mutations": false,
  "required_refactors": [
    {
      "id": "TS033-R01",
      "path": "core_enhanced/src/authoring/trial.rs:97-127",
      "detail": "Track a fixed attempt position outside run_with_provenance and update before initialization, every global-index step, and final readiness. Wrap both outer execution and inner domain errors without replacing native diagnostic code/phase."
    },
    {
      "id": "TS033-R02",
      "path": "core_enhanced/src/authoring/trial.rs:71-88",
      "detail": "Expose opaque public session and borrowed receipt/step views only; preserve absent slot versus JSON null and chronological initial/preparation-prefix/ready/execution receipt ordering."
    },
    {
      "id": "TS033-R03",
      "path": "core_enhanced/src/authoring/trial.rs:307-339",
      "detail": "Implement complete finite simulate by repeated actual one-step advances, moving the last accepted session into failure ownership. Never drop a partial accepted prefix or turn a failed preparation prefix into published state."
    },
    {
      "id": "TS033-R04",
      "path": "core_enhanced/src/game/world/authoring_observation.rs:50-59",
      "detail": "Map crate-private mandatory/trace view types to public scalar/borrowed wrappers, with no CoreApplication, GameCore, mutable borrow or native Arc exposure."
    },
    {
      "id": "TS033-R05",
      "path": "core_enhanced/src/authoring/query.rs:57-87,106-111,258-268",
      "detail": "Reuse current describe/explain; any new live snapshot/preview query needs its own bounded inspection scope and must not debit accepted trial quotas."
    },
    {
      "id": "TS033-R06",
      "path": "core_enhanced/src/authoring/mod.rs:47-86",
      "detail": "Keep the native typed failure authoritative. Diagnostic encoding/I/O failure is a separate transport result; render after the gameplay scope using explicit independent limits, not by recursively constructing a new gameplay error."
    }
  ],
  "not_proposed": [
    "public Clone/Deref/AsRef<CoreApplication>/inner borrowing",
    "new gameplay evaluator or auto clock loop",
    "publicly accepting unprepared initializer",
    "complete-session serde_json Value or copied accepted-prefix vector",
    "optional trace as mandatory receipt input or binder source"
  ],
