  "proposed_bridge": {
    "success_mappers": "Result<Self, ApplicationError>; public port signatures unchanged",
    "error_builders": "Self retained; return allocation-free unpublished Err envelope only after typed sticky checkpoint",
    "formatter": "bounded fmt::Write String with admission/charge before each push, followed by escaped JSON projection admission",
    "ordinary_semantics": "preserve existing kind/code/details/recovery disposition absent control failure",
    "no_recursive_fallback": true
  },
  "caller_mapping": {
    "result_ports": [
      "execute_internal",
      "active_battle_reconnect",
      "advance_active_battle_by",
      "advance_active_battle_for_host_tick (Option<Result>.transpose)",
      "advance_active_battle_to_next_event_bucket",
      "continue_from_active_run_checkpoint"
    ],
    "borrowed_display_callers": [
      "ApplicationCommand::from_document",
      "ApplicationCommand::from_json_slice",
      "ApplicationAdminCommand::from_document",
      "merge_player_profile",
      "merge_encounter_compendium_profile"
    ]
  },
  "parent_steering": "Root adopted intermediate Result/typed-checkpoint/error-envelope/bounded String fmt writer design and began implementation; this report does not review that successor.",
  "limits": [
