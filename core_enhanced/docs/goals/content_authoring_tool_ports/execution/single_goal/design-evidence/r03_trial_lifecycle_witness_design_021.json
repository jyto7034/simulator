  "design": [
    {
      "id": "O01",
      "recommendation": "Fixed optional Copy sidecar on GameCore; ordinary constructor disabled; private fresh authoring constructor and copied private accessor only.",
      "sources": [
        "world.rs:50-61,99-109",
        "application.rs:786-800"
      ]
    },
    {
      "id": "T01",
      "recommendation": "Begin actual entry before real zero advance; complete only after actual zero advance returns success; retain terminal across active removal.",
      "sources": [
        "world/combat.rs:636-689,1393-1406,1454-1568"
      ]
    },
    {
      "id": "T02",
      "recommendation": "Checked producer entry ordinal independent of gameplay UUID rewind and logs; explicit timezero/terminal/exit evidence, no fabricated readiness counter.",
      "sources": [
        "world/state.rs:579-594,460-463",
        "managers/uuid_manager.rs:38-42,90-92"
      ]
    },
    {
      "id": "A01",
      "recommendation": "Checked actual pre/post delta and cumulative total; TrialState actual cap check and receipt projection before encode_receipt.",
      "sources": [
        "world/combat.rs:1479-1522",
        "world/state.rs:827-840",
        "authoring/scenario.rs:520-534",
        "authoring/trial.rs:317-364"
      ]
    },
    {
      "id": "R01",
      "recommendation": "PreparedApplicationCommit explicitly carries sidecar; nonbattle inner transaction restores paired fixed snapshot on Err; gameplay rewind does not rewind tool counters.",
      "sources": [
        "world/application.rs:128-134,172-220",
        "world/node_flow.rs:784-803",
        "world/state.rs:388-470,541-595"
      ]
    }
  ],
