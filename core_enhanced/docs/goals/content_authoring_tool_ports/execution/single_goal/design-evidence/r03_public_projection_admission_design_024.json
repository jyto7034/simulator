  "report_id": "R03-PUBLIC-PROJECTION-ADMISSION-DESIGN-024",
  "role": "bounded read-only source design; not completion audit or full heap proof",
  "scope": "PT020-F01 first public JSON preadmission and exact ordinary serde mapping",
  "selected_design": {
    "root_selected": true,
    "sequence": [
      "inactive: unchanged serde_json::to_value",
      "active: borrowed count-only to_writer with checked ResultBytes/work per write",
      "precharge complete native conversion work",
      "unchanged serde_json::to_value",
      "post-conversion cancellation/sticky-failure poll"
    ],
    "object_projection": "private Field<T,Tail>/Object SerializeMap with literal keys and borrowed expressions; evaluate once; no json! before helper",
    "excluded_guarantees": [
      "native DTO work before helper",
      "physical allocator byte/peak bounds",
      "cancellation poll inside native to_value",
      "arbitrary impure user Serialize admission",
      "full public/admin/error/checkpoint coverage"
    ]
  },
