{
  "report_id": "r03_optional_trace_isolation_design_031",
  "role": "bounded read-only source/design assistance; not implementation/completion audit",
  "authorization": "parent task under adopted AUTORUN §8",
  "production_mutations": false,
  "tests_builds_or_runtime_executed": false,
  "captured_read_start": "2026-09-10T12:34:57.537180+00:00",
  "captured_read_end": "2026-09-10T12:46:12.829632+00:00",
  "root_selected_proposal": {
    "optional_ledger": "one scalar TLS allowance per prepare-prefix or advance attempt; RAII; missing scope is gap only",
    "buffer": "Arc<String> NDJSON; complete retained prefix; stop on first gap",
    "mandatory_clone_shape": "fixed exhaustive OptionalTraceState shape independent of enabled/count/bytes/gap",
    "terminal": "serde(skip) optional state; separate borrowed view; native move before active removal",
    "configuration": "trusted validated TrialLimits through private constructors and combat setup"
  },
  "concrete_risks": [
    {
      "id": "R01",
      "statement": "Arc<String> detach plus following capacity growth can copy retained prefix twice; len+chunk alone does not bound every copy",
      "status": "design caveat, concurrent implementation not reviewed",
      "proposal": "Precharge detach and growth separately, or explicitly reserve fresh old+chunk and copy once; price future unique growth."
    },
    {
      "id": "R02",
      "statement": "Pinned serde_json str escaping scans source bytes before invoking writer fragments",
      "source": "serde_json-1.0.140/src/ser.rs:2077-2126",
      "proposal": "Checked O(1) source string-length precharge in independent optional ledger before to_writer; separate actual byte/growth allowance."
    },
    {
      "id": "R03",
      "statement": "TerminalCapsule is currently fully serialized into mandatory observation receipt",
      "source": "world/authoring_observation.rs:17-43; authoring/trial.rs:166-195,460-498",
      "proposal": "serde(skip) trace field plus separate borrowed view; no variable trace field in mandatory DTO."
    },
    {
      "id": "R04",
      "statement": "Generic Option CloneShape conditionally visits inner storage and cannot directly meter optional variable state",
      "source": "authoring/clone_shape.rs:107-114",
      "proposal": "Complete fixed custom OptionalTraceState visitor; native clone is Copy + Arc handle."
    },
    {
      "id": "R05",
      "statement": "Setup startup precedes actual world key binding",
      "source": "events/combat.rs:221-225; world/authoring_lifecycle.rs:85-120",
      "proposal": "Encode actual witness without synthetic entry identity, attach actual bound key in view."
    }
  ],
  "known_limits": [
    "HP/Stats application coverage only",
    "Latest active/latest terminal retention, not complete all-battle archive",
    "No exact process allocator/OS heap bound",
    "No deterministic asynchronous cancellation timing claim",
    "Concurrent authoring_observation.rs close version hash-only and unreviewed",
    "Numeric optional defaults/hard ceilings and measured runtime costs remain root implementation/validation work"
  ],
