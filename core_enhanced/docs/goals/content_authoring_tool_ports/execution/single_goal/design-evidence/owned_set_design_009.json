  "decision": {
    "minimal_seam": "One private MapCloneHistory sidecar for BattlefieldLayout.static_obstacles; explicit tombstone-free capacity envelope for the seven other named fields; preserve raw public fields/native Clone; no generic OwnedHashSet framework.",
    "phase": "proposed, not implemented by helper",
    "opaque_obstacle_note": "Production opaque path currently insert/clear-only; sidecar covers the separately public deletion-capable owner API."
  },
  "observations": [
    {
      "id": "OS009-O01",
      "topic": "public_VN_provenance",
      "conclusion": "Both public VN fields are insert-only in the fresh opaque owner family, including fresh byte deserialization and captured-state restoration. Arbitrary externally mutated values of the public type are not certified."
    },
    {
      "id": "OS009-O02",
      "topic": "battlefield",
      "conclusion": "valid_tiles is freshly collected from Vec then immutable. static_obstacles exposes controlled remove; one private lifetime insertion sidecar covers all public paths while leaving signatures/native sets unchanged."
    },
    {
      "id": "OS009-O03",
      "topic": "other_insert_only_owners",
      "fields": [
        "ScenarioRuntimeState.spawned_groups",
        "BossEncounterRuntime.latched_signals",
        "ActiveBossPattern.cleared_batch_handles",
        "BattleEmployeeAttemptState.processed_incapacitations"
      ],
      "conclusion": "Creation/insert/whole owner replacement or drop/Clone found; no in-place deletion path found in scoped ordinary code."
    },
    {
      "id": "OS009-O04",
      "topic": "empty_clear_caveat",
      "source": "/tmp/r03-hashbrown-0.15.5-raw-mod.rs:850-854",
      "conclusion": "RawTable::clear on len==0 returns without clearing tombstones. Never reset obstacle history merely because clear was called."
    },
    {
      "id": "OS009-O05",
      "topic": "all_retained_copies",
      "conclusion": "Count each owned live/checkpoint/entry-snapshot set separately; equality or capture ancestry does not imply Arc allocation sharing."
    },
    {
      "id": "OS009-O06",
      "topic": "bucket_model",
      "conclusion": "capacity is a usable-item lower bound generally, full usable capacity under a verified tombstone-free invariant. Apply a checked bucket envelope rather than count capacity or len directly as buckets."
    }
  ],
