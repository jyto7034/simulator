{
  "uid": "core-runtime",
  "title": "Core runtime safety and observation",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "core",
    "runtime"
  ],
  "editable": false,
  "links": [
    {
      "title": "Selected identity / 300-row detail ring",
      "type": "link",
      "url": "http://127.0.0.1:9110/state",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Active battles and committed operations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "core-runtime"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "core_runtime_active_battles",
          "legendFormat": "active battles",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "core-runtime"
          }
        },
        {
          "refId": "B",
          "expr": "rate(core_runtime_commits_total[10s])",
          "legendFormat": "commits / wall second",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "core-runtime"
          }
        }
      ],
      "description": "Root publications only; ended or dropped sessions leave the active aggregate.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Returned rejections \u2014 once per public operation",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "core-runtime"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "core_runtime_rejections_total > 0",
          "legendFormat": "{{reason}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "core-runtime"
          }
        }
      ],
      "description": "Native first-fault code or finite application error kind. Internal polls do not increment counters.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
