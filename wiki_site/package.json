{
  "name": "ark-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "content": "node scripts/run-content.mjs",
    "dev": "npm run content && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run content && npm run build:app",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node scripts/check.mjs",
    "build:app": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs"
  },
  "dependencies": {
    "@fontsource/noto-serif-kr": "5.3.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "pretendard": "1.3.9",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
